#

#
# FAIR Scheuler tunables
#
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

#
# Bluetooth device drivers
#
# CONFIG_NFC_NQ is not set
CONFIG_NXP_NFC_I2C=y

#
# FingerprintCard fingerprint driver
#
# CONFIG_FPR_FPC is not set

#
# Input Device Drivers
#
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_HIMAX_CHIPSET is not set
CONFIG_INPUT_DRV260X_HAPTICS=y

#
# Qualcomm Technologies, Inc. Charger and Fuel Gauge support
#
# CONFIG_SMB1390_CHARGE_PUMP_PSY is not set

#
# USB Power Delivery
#
# CONFIG_MMC is not set

#
# Qualcomm Atheros CLD WLAN module
#
CONFIG_QCA_CLD_WLAN=y

#
# Pseudo filesystems
#
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_UNICODE=y
